PORT=3000
APP_ORIGIN=http://localhost:3000
# Generate two DIFFERENT values: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-session-secret
JWT_SECRET=replace-with-a-different-random-jwt-secret
JWT_TTL_SECONDS=120
SESSION_TTL_SECONDS=900
# false for local HTTP; HTTPS is required for secure cookies outside localhost.
COOKIE_SECURE=false
